{
  "name": "upshift-learning-platform",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "next dev apps/web",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "build": "npm run db:generate && npm run build:web && npm run build:api",
    "build:web": "next build apps/web",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "start:web": "next start apps/web",
    "start:api": "node apps/api/dist/index.js",
    "lint": "eslint apps/web/src apps/api/src",
    "typecheck": "tsc --noEmit -p apps/api/tsconfig.json && next typegen apps/web && tsc --noEmit -p apps/web/tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "next": "^15.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.15",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.12",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.38.0",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.1.15",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "postcss": "^8.5.31"
  }
}
